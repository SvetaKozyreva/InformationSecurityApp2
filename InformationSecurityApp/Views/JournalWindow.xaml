<Window x:Class="InformationSecurityApp.Views.JournalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InformationSecurityApp.Views"
        mc:Ignorable="d"
                Title="Журнал подій"
        Height="500"
        Width="750"
        MinHeight="300"
        MinWidth="450"
        WindowStartupLocation="CenterScreen" Background="#FFFFDCDC">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="JournalTextBox"
                 Grid.Row="0"
                 IsReadOnly="True"
                 TextWrapping="NoWrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="13"
                 Padding="10" Background="#FFFFF5F5"/>

        <Button Grid.Row="1"
                Content="Закрити"
                Width="100"
                Height="32"
                Margin="0,12,0,0"
                HorizontalAlignment="Right"
                Foreground="White"
                FontSize="13"
                FontWeight="SemiBold"
                Cursor="Hand"
                Click="CloseButton_Click" Background="#C86D6D"/>
    </Grid>
</Window>