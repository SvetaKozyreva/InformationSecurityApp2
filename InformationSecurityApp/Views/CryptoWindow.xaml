<Window x:Class="InformationSecurityApp.Views.CryptoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Криптографічний захист ElGamal"
        Height="816" Width="850"
        MinHeight="650" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Background="#FFF7F7">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="25">

            <TextBlock Text="Криптографічний захист ElGamal"
                       FontSize="24" FontWeight="Bold"
                       Foreground="#9E5151"
                       Margin="0,0,0,20"/>

            <GroupBox Header="Ключі" Padding="5" Margin="0,0,0,5">
                <StackPanel>
                    <TextBlock Text="Відкритий ключ (Public Key)"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="PublicKeyBox"
                             FontSize="14" Padding="7"
                             Margin="0,0,0,12"
                             IsReadOnly="True"/>

                    <TextBlock Text="Закритий ключ (Private Key)"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="PrivateKeyBox"
                             FontSize="14" Padding="7"
                             Margin="0,0,0,12"
                             IsReadOnly="True"/>

                    <Button Content="Згенерувати ключі"
                            Click="GenerateKeysButton_Click"
                            Height="38" Width="220"
                            HorizontalAlignment="Left"
                            Background="#C86D6D" Foreground="White"
                            FontWeight="SemiBold"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Шифрування" Padding="5" Margin="0,0,0,5">
                <StackPanel>
                    <TextBlock Text="Вихідний текст:" Margin="0,0,0,5"/>
                    <TextBox x:Name="PlainTextBox"
                             Height="61" Padding="8"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,10"/>

                    <Button Content="Завантажити input.txt"
                            Click="LoadInputButton_Click"
                            Height="27" Width="220"
                            HorizontalAlignment="Left"
                            Background="#E8CACA"
                            Foreground="#593737"
                            Margin="0,0,0,10"/>

                    <Button Content="Зашифрувати"
                            Click="EncryptButton_Click"
                            Height="38" Width="160"
                            HorizontalAlignment="Left"
                            Background="#C86D6D" Foreground="White"
                            FontWeight="SemiBold"
                            Margin="0,0,0,12"/>

                    <TextBlock Text="Зашифровані дані:"
                   Margin="0,0,0,5"/>

                    <TextBox x:Name="DecryptCipherTextBox"
                 Height="86"
                 Padding="8"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Margin="0,0,0,10"/>

                    <Button Content="Завантажити close.txt"
                Click="LoadCloseButton_Click"
                Height="26"
                Width="220"
                HorizontalAlignment="Left"
                Background="#E8CACA"
                Foreground="#593737"
                Margin="0,0,0,10"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Розшифрування" Padding="5">
                <StackPanel>
                    <TextBlock Text="Результат розшифрування:"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="DecryptedTextBox"
                             Height="71" Padding="8"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             IsReadOnly="True"
                             Margin="0,0,0,10"/>

                    <Button Content="Розшифрувати"
                            Click="DecryptButton_Click"
                            Height="38" Width="160"
                            HorizontalAlignment="Left"
                            Background="#C86D6D" Foreground="White"
                            FontWeight="SemiBold"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Цифровий підпис ElGamal"
          Padding="12" Margin="0,15,0,0">
                <StackPanel>
                    <TextBlock Text="Цифровий підпис (r, s):"
                   Margin="0,0,0,5"/>

                    <TextBox x:Name="SignatureBox"
                 Height="55"
                 Padding="8"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 Margin="0,0,0,10"/>

                    <WrapPanel>
                        <Button Content="Створити підпис"
                    Click="SignButton_Click"
                    Height="38"
                    Padding="12,0"
                    Margin="0,0,10,10"
                    Background="#C86D6D"
                    Foreground="White"
                    FontWeight="SemiBold"/>

                        <Button Content="Перевірити підпис"
                    Click="VerifySignatureButton_Click"
                    Height="38"
                    Padding="12,0"
                    Margin="0,0,0,10"
                    Background="#E8CACA"
                    Foreground="#593737"
                    FontWeight="SemiBold"/>
                    </WrapPanel>

                    <TextBlock x:Name="SignatureStatusText"
                   TextWrapping="Wrap"
                   FontSize="14"
                   Margin="0,5,0,0"/>
                </StackPanel>
            </GroupBox>


            <TextBlock Text="Навчальна реалізація алгоритму ElGamal. Не призначена для захисту реальних конфіденційних даних."
                       TextWrapping="Wrap"
                       Foreground="#805858"
                       Margin="0,15,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Window>
