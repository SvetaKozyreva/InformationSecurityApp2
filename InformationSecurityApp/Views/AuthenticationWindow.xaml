<Window x:Class="InformationSecurityApp.Views.AuthenticationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Стохастична автентифікація"
        Height="740"
        Width="740"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F7F5F5">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FCE5E5"
                CornerRadius="14"
                Padding="20">
            <StackPanel>
                <TextBlock Text="ПЕРЕВІРКА ОСОБИ"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="#B85C5C"/>

                <TextBlock Text="Стохастична автентифікація"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#493F3F"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"/>

                <TextBlock x:Name="UserText"
                           Text="Користувач"
                           FontSize="14"
                           Foreground="#655A5A"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#EADADA"
                BorderThickness="1"
                CornerRadius="14"
                Padding="20"
                Margin="0,18,0,0">

            <StackPanel>
                <TextBlock Text="Ваше завдання"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#493F3F"/>

                <TextBlock Text="Обчисліть значення функції для заданого X:"
                           FontSize="14"
                           TextWrapping="Wrap"
                           Margin="0,12,0,8"/>

                <TextBlock Text="F(X) = 4X · ln(7)"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#B85C5C"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,12"/>

                <Border Background="#F7F5F5"
                        CornerRadius="10"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="Згенероване значення X"
                                   FontSize="13"
                                   Foreground="#817575"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="ChallengeText"
                                   Text="—"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#493F3F"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Введіть обчислене значення F(X):"
                           FontSize="14"
                           Margin="0,16,0,6"/>

                <TextBox x:Name="AnswerBox"
                         Height="40"
                         Padding="10"
                         FontSize="16"
                         VerticalContentAlignment="Center"/>

                <TextBlock Text="Вводьте відповідь із точністю до 2 знаків після коми."
                           FontSize="12"
                           Foreground="#817575"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>

                <TextBlock x:Name="ResultText"
                           TextWrapping="Wrap"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,12,0,0"/>

                <Button Content="Перевірити відповідь"
                        Height="42"
                        Margin="0,14,0,0"
                        Background="#C86D6D"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CheckButton_Click"/>

                <Button Content="Нове завдання"
                        Height="38"
                        Margin="0,8,0,0"
                        Background="#EADADA"
                        Foreground="#493F3F"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="NewChallengeButton_Click"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="Результат перевірки записується до журналу подій."
                   FontSize="12"
                   Foreground="#817575"
                   TextWrapping="Wrap"
                   VerticalAlignment="Bottom"
                   Margin="0,12,0,0"/>
    </Grid>
</Window>
