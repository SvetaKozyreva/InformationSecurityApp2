<Window x:Class="InformationSecurityApp.Views.UserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управління користувачами"
        Height="760"
        Width="950"
        MinHeight="680"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F7F5F5">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="Управління користувачами"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#493F3F"/>

                <TextBlock Text="Реєстрація, перегляд облікових записів і налаштування прав"
                           FontSize="13"
                           Foreground="#817575"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Додавання користувача -->
            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#EADADA"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16"
                    Margin="0,0,0,14">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="0.9*"/>
                        <ColumnDefinition Width="1.3*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="4">
                        <TextBlock Text="Логін" Margin="0,0,0,6"
                                   Foreground="#514747"/>
                        <TextBox x:Name="LoginBox"
                                 Height="34" Padding="7"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="#E4CACA"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="4">
                        <TextBlock Text="Пароль" Margin="0,0,0,6"
                                   Foreground="#514747"/>
                        <PasswordBox x:Name="PasswordBox"
                                     Height="34" Padding="7"
                                     BorderBrush="#E4CACA"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="4">
                        <TextBlock Text="Роль" Margin="0,0,0,6"
                                   Foreground="#514747"/>
                        <ComboBox x:Name="RoleBox"
                                  Height="34"
                                  SelectedIndex="0"
                                  VerticalContentAlignment="Center">
                            <ComboBoxItem Content="User"/>
                            <ComboBoxItem Content="Admin"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="4">
                        <TextBlock Text="Пароль дійсний до"
                                   Margin="0,0,0,6"
                                   Foreground="#514747"/>
                        <DatePicker x:Name="ExpiryPicker"
                                    Height="34"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Налаштування прав -->
            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#EADADA"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16"
                    Margin="0,0,0,14">

                <StackPanel>
                    <TextBlock Text="Права доступу до каталогів"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#493F3F"/>

                    <TextBlock Text="Виберіть користувача в таблиці, каталог і потрібні права."
                               Margin="0,5,0,12"
                               Foreground="#817575"
                               TextWrapping="Wrap"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Каталог"
                                       Margin="0,0,0,6"
                                       Foreground="#514747"/>

                            <ComboBox x:Name="DirectoryBox"
                                      Height="36"
                                      SelectedIndex="0"
                                      SelectionChanged="DirectoryBox_SelectionChanged">
                                <ComboBoxItem Content="A"/>
                                <ComboBoxItem Content="B"/>
                                <ComboBoxItem Content="C"/>
                                <ComboBoxItem Content="D"/>
                                <ComboBoxItem Content="E"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Дозволені дії"
                                       Margin="0,0,0,6"
                                       Foreground="#514747"/>

                            <WrapPanel VerticalAlignment="Center">
                                <CheckBox x:Name="ReadCheck"
                                          Content="R — читання"
                                          Margin="0,8,16,8"/>

                                <CheckBox x:Name="WriteCheck"
                                          Content="W — запис"
                                          Margin="0,8,16,8"/>

                                <CheckBox x:Name="AppendCheck"
                                          Content="A — доповнення"
                                          Margin="0,8,16,8"/>

                                <CheckBox x:Name="ExecuteCheck"
                                          Content="E — виконання"
                                          Margin="0,8,0,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="PermissionsInfoText"
                               Text="Виберіть користувача в таблиці нижче."
                               Margin="0,8,0,10"
                               Foreground="#817575"
                               TextWrapping="Wrap"/>

                    <Button Content="Зберегти права доступу"
                            Height="38"
                            Width="210"
                            HorizontalAlignment="Left"
                            Background="#C86D6D"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="SavePermissionsButton_Click"/>
                </StackPanel>
            </Border>

            <!-- Список користувачів -->
            <Border Grid.Row="3"
                    Background="White"
                    BorderBrush="#EADADA"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="10"
                    MinHeight="180"
                    Margin="0,0,0,14">

                <DataGrid x:Name="UsersGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          Background="White"
                          BorderThickness="0"
                          RowHeight="36"
                          FontSize="13"
                          SelectionChanged="UsersGrid_SelectionChanged">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Логін"
                                            Binding="{Binding Login}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Роль"
                                            Binding="{Binding Role}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Пароль дійсний до"
                                            Binding="{Binding PasswordValidUntil,
                                                StringFormat={}{0:dd.MM.yyyy}}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Кнопки -->
            <WrapPanel Grid.Row="4"
                       HorizontalAlignment="Right">

                <Button Content="Оновити список"
                        MinWidth="130"
                        Height="38"
                        Padding="12,6"
                        Margin="0,0,8,8"
                        Background="#EADADA"
                        Foreground="#493F3F"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="RefreshButton_Click"/>

                <Button Content="Додати користувача"
                        MinWidth="160"
                        Height="38"
                        Padding="12,6"
                        Margin="0,0,8,8"
                        Background="#C86D6D"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="AddButton_Click"/>

                <Button Content="Видалити вибраного"
                        MinWidth="160"
                        Height="38"
                        Padding="12,6"
                        Margin="0,0,0,8"
                        Background="White"
                        Foreground="#A94F4F"
                        BorderBrush="#E4CACA"
                        Cursor="Hand"
                        Click="DeleteButton_Click"/>
            </WrapPanel>
        </Grid>
    </ScrollViewer>
</Window>
