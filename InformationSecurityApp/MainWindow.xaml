<Window x:Class="InformationSecurityApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Information Security App"
        Height="500"
        Width="850"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FFFAF3F3">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#FFD2747E"
                Padding="35">

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="INFORMATION"
                           Foreground="White"
                           FontSize="19"
                           FontWeight="Bold"/>

                <TextBlock Text="SECURITY APP"
                           Foreground="White"
                           FontSize="29"
                           FontWeight="Bold"
                           Margin="0,5,0,20"/>

                <TextBlock Text="Система ідентифікації користувачів та криптографічного захисту інформації."
                           Foreground="White"
                           FontSize="16"
                           TextWrapping="Wrap"/>

                <TextBlock Text="Навчальний проєкт"
                           Foreground="#E7E0F5"
                           FontSize="13"
                           Margin="0,35,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="35">
            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="Вхід у систему"
                           FontSize="27"
                           FontWeight="Bold"
                           Foreground="#30284A"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Введіть свої облікові дані"
                           FontSize="14"
                           Foreground="#777184"
                           Margin="0,0,0,25"/>

                <TextBlock Text="Логін"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="LoginBox"
                         Height="38"
                         FontSize="15"
                         Padding="8"
                         Margin="0,0,0,16"/>

                <TextBlock Text="Пароль"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <PasswordBox x:Name="PasswordBox"
                             Height="38"
                             FontSize="15"
                             Padding="8"
                             Margin="0,0,0,22"/>

                <Button Content="Увійти"
                        Height="43"
                        Background="#FFD2747E"
                        Foreground="White"
                        FontSize="15"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="LoginButton_Click"/>

                <TextBlock x:Name="StatusText"
                           Foreground="#B34242"
                           TextWrapping="Wrap"
                           Margin="0,15,0,0"
                           FontSize="13"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
